{
	"name": "obsidian-yadisk-sync",
	"version": "1.6.1",
	"description": "Obsidian plugin for Yandex Disk synchronization",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"test": "esbuild test/*.test.ts --bundle --platform=node --format=esm --outdir=.test-build --out-extension:.js=.mjs --log-level=warning && node --test .test-build/*.test.mjs"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"esbuild": "^0.20.0",
		"obsidian": "~1.12.3",
		"typescript": "^5.3.0"
	},
	"license": "MIT"
}
